# Copy to .env for local runs. All values are OPTIONAL — anything left blank
# can be configured later in the dashboard Settings page.

# Admin password for the dashboard (if blank, a random one is generated and
# written to data/admin_bootstrap.txt on first boot).
ADMIN_PASSWORD=

# Kaggle credentials (one authorized identity; or use KAGGLE_API_TOKEN below).
KAGGLE_USERNAME=
KAGGLE_KEY=
# Bearer-token fallback used when no username/key pair is configured.
KAGGLE_API_TOKEN=

# AI assistant provider (any OpenAI-compatible chat completions endpoint).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Backend tuning (defaults shown).
# DATA_DIR=./data
# POLL_SECONDS=6
