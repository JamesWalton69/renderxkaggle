# Admin password for the web dashboard (required)
ADMIN_PASSWORD=change-me

# Kaggle accounts — one JSON array listing every account
# {name, username, key}. IDs are 1-based by list order; the first is the
# default. Credentials come from the environment ONLY — the dashboard has
# no credential entry forms anymore.
KAGGLE_ACCOUNTS=[{"name":"Account A","username":"u1","key":"k1"},{"name":"Account B","username":"u2","key":"k2"}]

# Legacy single-account fallbacks — used only if KAGGLE_ACCOUNTS is
# empty/invalid. Same effect as one account in the JSON list.
#KAGGLE_USERNAME=
#KAGGLE_KEY=

# Bearer-token fallback (when no username/key pair is configured at all).
#KAGGLE_API_TOKEN=

# Optional AI-provider defaults (still editable in dashboard Settings).
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=
#AI_MODEL=gpt-4o-mini

# Worker poll interval in seconds.
POLL_SECONDS=6
